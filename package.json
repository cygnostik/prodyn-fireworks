{
  "name": "afterlight-fireworks",
  "version": "1.2.0",
  "private": true,
  "description": "An open-source 3D fireworks instrument. Build a sky, layer a finale, take it offline.",
  "license": "MIT",
  "homepage": "https://fireworks.prodyn.ai/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cygnostik/prodyn-fireworks.git"
  },
  "bugs": {
    "url": "https://github.com/cygnostik/prodyn-fireworks/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/build-pages.mjs",
    "build": "vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests *.js index.html package.json",
    "format:check": "prettier --check src scripts tests *.js index.html package.json",
    "check": "npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "vite": "8.2.2"
  }
}
